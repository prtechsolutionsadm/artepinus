# Prisma Postgres: string de conexão "Direct TCP" (começa com postgres://)
# Dashboard em console.prisma.io → seu banco → Connect / API Keys
# Local: rode `npm run db:local` e cole aqui a URL postgres:// exibida
# (sem DATABASE_URL, o app e o migrate usam POSTGRES_URL, criada pela integração da Vercel)
DATABASE_URL="postgres://IDENTIFICADOR:CHAVE@db.prisma.io:5432/postgres?sslmode=require"
# Segredo da sessão (gere com: openssl rand -base64 32)
AUTH_SECRET=""
# Notificações push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato enviado ao serviço de push (opcional; padrão em src/lib/notificacoes.ts)
# VAPID_SUBJECT="mailto:contato@seu-dominio"
# Protege as rotinas agendadas (vercel.json): /api/cron/lembretes (7h: preventivas, lembretes,
# alertas e limpeza LGPD) e /api/cron/serraria (18h, seg–sex). A Vercel envia automaticamente;
# sem ele as rotinas respondem 401.
CRON_SECRET=""
# Endereço público gravado nos links do QR das etiquetas e no preview de links; defina em produção.
# Sem ela, os deploys da Vercel usam EMPRESA.site (src/lib/empresa.ts) e, fora da Vercel (`npm run dev`,
# `npm start` local ou homologação), os QR usam o host da requisição.
# Deixe comentada no .env local para não imprimir QR apontando para a produção.
# NEXT_PUBLIC_SITE_URL="https://artepinus.vercel.app"
# Senha provisória do admin criado pelo seed (só quando não há nenhum administrador); se vazia, é
# sorteada e mostrada no terminal/log do build. Troca obrigatória no primeiro acesso.
# ADMIN_SENHA_INICIAL=""
# Dados de exemplo: só em banco local (`SEED_DEMO=1 npm run db:seed`). Nunca defina na Vercel: o seed
# roda em todo deploy e criaria usuários com senha conhecida (ele recusa na Vercel e em db.prisma.io).
# SEED_DEMO=1
