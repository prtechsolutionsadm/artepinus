// Sistema de Manutenção - Artepinus
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN // desenvolvedor do sistema (acesso total, não atribuível pela tela)
  GERENTE // gestão: usuários, setores, relatórios e todas as requisições
  SUPERVISOR // coordena a manutenção: atribui, agenda, cancela, relatórios
  MANUTENTOR // executa: atualiza status e registra o serviço
  OPERADOR // abre requisições e acompanha
  SEM_ACESSO // não usa o módulo de manutenção (só outros módulos)
}

/// Papel no módulo de Produção (Admin e Gerente têm acesso total sem precisar deste campo).
enum PerfilProducao {
  SUPERVISOR // metas, cadastros, edita e exclui qualquer lançamento
  APONTADOR // lança boletins, paradas, ciclos de estufa, toras e estoque
  CONSULTA // só vê painéis e relatórios
}

enum StatusRequisicao {
  ABERTA // recém criada, aguardando análise
  EM_ANALISE // manutenção avaliando
  PLANEJADA // aprovada, aguardando data
  AGENDADA // data definida
  EM_ANDAMENTO // em execução
  AGUARDANDO_PECAS // parada por falta de material
  ADIADA // postergada
  CONCLUIDA // finalizada
  CANCELADA // não será executada
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoManutencao {
  CORRETIVA
  PREVENTIVA
  PREDITIVA
  MELHORIA
}

model Usuario {
  id                String          @id @default(cuid())
  nome              String
  login             String          @unique // nome.sobrenome
  /// muda quando a senha é trocada/redefinida: derruba as sessões abertas em outros aparelhos
  /// pergunta de segurança escolhida (índice em PERGUNTAS_SEGURANCA) e a resposta embaralhada (bcrypt)
  perguntaSeguranca Int?
  respostaHash      String?
  versaoSessao      Int             @default(0)
  trocarSenha       Boolean         @default(false) // obriga a trocar a senha no próximo acesso
  senhaHash         String
  perfil            Perfil          @default(OPERADOR) // papel no módulo de Manutenção
  perfilProducao    PerfilProducao? // papel no módulo de Produção (vazio = sem acesso)
  ativo             Boolean         @default(true)
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  requisicoesAbertas    Requisicao[]          @relation("Solicitante")
  requisicoesAtribuidas Requisicao[]          @relation("Responsavel")
  historicos            HistoricoStatus[]
  comentarios           Comentario[]
  notificacaos          Notificacao[]
  inscricaoPushes       InscricaoPush[]
  anexos                Anexo[]
  apontamentos          Apontamento[]
  itensMarcados         ChecklistItem[]
  planosResponsavel     PlanoPreventivo[]     @relation("PlanosResponsavel")
  planosCriados         PlanoPreventivo[]     @relation("PlanosCriados")
  auditorias            Auditoria[]
  boletins              BoletimProducao[]
  ciclosSecagem         CicloSecagem[]
  itensCicloMarcados    ItemChecklistCiclo[]
  cargasToras           CargaToras[]
  levantamentosEstoque  LevantamentoEstoque[]
  colheitas             Colheita[]
  pacotesCriados        Pacote[]
  eventosPacote         EventoPacote[]
  romaneios             Romaneio[]            @relation("RomaneiosCriados")
  lotes                 Lote[]
  plantoes              CicloSecagem[]        @relation("PlantaoCiclo")
  paradasAbertas        ParadaMaquina[]       @relation("ParadaAberta")
  paradasEncerradas     ParadaMaquina[]       @relation("ParadaEncerrada")
}

model Setor {
  id           String        @id @default(cuid())
  nome         String        @unique
  equipamentos Equipamento[]
  requisicoes  Requisicao[]
}

model Equipamento {
  id              String            @id @default(cuid())
  codigo          String            @unique // patrimônio / TAG
  nome            String
  descricao       String?
  setorId         String?
  setor           Setor?            @relation(fields: [setorId], references: [id])
  ativo           Boolean           @default(true)
  fabricante      String?
  modelo          String?
  numeroSerie     String?
  requisicoes     Requisicao[]
  planos          PlanoPreventivo[]
  motivosParada   MotivoParada[]
  paradasProducao ParadaProducao[]
  estufa          Estufa?
  /// Máquina da linha da serraria: aparece no botão "Máquina parou" e as paradas entram no boletim
  linhaSerraria   Boolean           @default(false)
  paradasMaquina  ParadaMaquina[]
}

model Requisicao {
  id         Int              @id @default(autoincrement()) // nº da requisição
  titulo     String
  descricao  String
  tipo       TipoManutencao   @default(CORRETIVA)
  prioridade Prioridade       @default(MEDIA)
  status     StatusRequisicao @default(ABERTA)
  local      String?

  solicitanteId String
  solicitante   Usuario      @relation("Solicitante", fields: [solicitanteId], references: [id])
  responsavelId String?
  responsavel   Usuario?     @relation("Responsavel", fields: [responsavelId], references: [id])
  setorId       String?
  setor         Setor?       @relation(fields: [setorId], references: [id])
  equipamentoId String?
  equipamento   Equipamento? @relation(fields: [equipamentoId], references: [id])

  dataAgendada  DateTime?
  dataInicio    DateTime?
  dataConclusao DateTime?
  solucao       String? // o que foi feito
  lembreteEm    DateTime? // quando o lembrete do dia agendado foi enviado

  // Equipamento parado por causa do problema (tempo de máquina parada)
  maquinaParada Boolean   @default(false)
  paradaInicio  DateTime?
  paradaFim     DateTime?

  paradasProducao ParadaProducao[] // paradas da produção que originaram esta requisição
  paradaMaquina   ParadaMaquina? // parada da linha da serraria ligada a esta requisição

  /// Chave gerada no aparelho para requisições abertas sem internet (evita duplicar no reenvio)
  chaveOffline String? @unique

  planoId String? // preventiva gerada automaticamente por este plano
  plano   PlanoPreventivo? @relation(fields: [planoId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historico    HistoricoStatus[]
  comentarios  Comentario[]
  anexos       Anexo[]
  apontamentos Apontamento[]
  checklist    ChecklistItem[]

  @@index([status])
  @@index([equipamentoId])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([criadoEm])
}

model HistoricoStatus {
  id             String            @id @default(cuid())
  requisicaoId   Int
  requisicao     Requisicao        @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  statusAnterior StatusRequisicao?
  statusNovo     StatusRequisicao
  observacao     String?
  usuarioId      String
  usuario        Usuario           @relation(fields: [usuarioId], references: [id])
  criadoEm       DateTime          @default(now())

  @@index([requisicaoId])
}

model Comentario {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  autorId      String
  autor        Usuario    @relation(fields: [autorId], references: [id])
  texto        String
  criadoEm     DateTime   @default(now())

  @@index([requisicaoId])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId, lida, criadoEm])
}

/// Aparelho (navegador) inscrito para receber push.
model InscricaoPush {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

enum TipoAnexo {
  PROBLEMA // foto do problema (abertura / comentários)
  SERVICO // foto do serviço realizado
}

/// Foto anexada à requisição. Guardada comprimida no próprio banco (JPEG) e servida
/// só para usuários logados pela rota /api/anexos/[id].
model Anexo {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  autorId      String
  autor        Usuario    @relation(fields: [autorId], references: [id])
  tipo         TipoAnexo  @default(PROBLEMA)
  mime         String
  dados        Bytes
  miniatura    Bytes
  largura      Int
  altura       Int
  tamanho      Int
  criadoEm     DateTime   @default(now())

  @@index([requisicaoId])
}

/// Horas trabalhadas por um manutentor numa requisição.
model Apontamento {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  inicio       DateTime
  minutos      Int
  descricao    String?
  criadoEm     DateTime   @default(now())

  @@index([requisicaoId])
  @@index([usuarioId, inicio])
}

model ChecklistModelo {
  id     String                @id @default(cuid())
  nome   String                @unique
  ativo  Boolean               @default(true)
  itens  ChecklistModeloItem[]
  planos PlanoPreventivo[]
}

model ChecklistModeloItem {
  id       String          @id @default(cuid())
  modeloId String
  modelo   ChecklistModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  texto    String
  ordem    Int

  @@index([modeloId, ordem])
}

/// Item de checklist copiado para a requisição (alterar o modelo não muda requisições antigas).
model ChecklistItem {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  texto        String
  ordem        Int
  feito        Boolean    @default(false)
  feitoPorId   String?
  feitoPor     Usuario?   @relation(fields: [feitoPorId], references: [id])
  feitoEm      DateTime?

  @@index([requisicaoId, ordem])
}

enum UnidadeFrequencia {
  DIAS
  SEMANAS
  MESES
}

/// Plano de manutenção preventiva: gera requisições agendadas automaticamente.
model PlanoPreventivo {
  id               String            @id @default(cuid())
  equipamentoId    String
  equipamento      Equipamento       @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  titulo           String
  descricao        String?
  intervalo        Int
  unidade          UnidadeFrequencia @default(DIAS)
  proximaData      DateTime // data/hora da próxima execução
  /// dia do mês de referência (Brasília) dos planos mensais: evita que o plano escorregue para o dia 28
  diaDoMes         Int?
  antecedenciaDias Int               @default(3) // gera a requisição N dias antes
  prioridade       Prioridade        @default(MEDIA)
  responsavelId    String?
  responsavel      Usuario?          @relation("PlanosResponsavel", fields: [responsavelId], references: [id])
  checklistId      String?
  checklist        ChecklistModelo?  @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  ativo            Boolean           @default(true)
  criadoPorId      String // aparece como solicitante das requisições geradas
  criadoPor        Usuario           @relation("PlanosCriados", fields: [criadoPorId], references: [id])
  criadoEm         DateTime          @default(now())
  requisicoes      Requisicao[]

  @@index([ativo, proximaData])
}

/// Registro de quem alterou o quê (auditoria).
model Auditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao       String // ex.: "requisicao.status", "usuario.editar", "login"
  entidade   String // ex.: "Requisicao", "Usuario"
  entidadeId String?
  resumo     String
  detalhes   Json?
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade, entidadeId])
  @@index([usuarioId, criadoEm])
}

// ============================ MÓDULO DE PRODUÇÃO ============================

enum CentroParada {
  MEC // mecânica
  ELE // elétrica
  OPE // operacional
}

/// Catálogo de motivos de parada da linha (códigos da planilha da serraria).
model MotivoParada {
  id             String           @id @default(cuid())
  codigo         Int              @unique
  descricao      String
  centro         CentroParada
  equipamentoId  String?
  equipamento    Equipamento?     @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  ativo          Boolean          @default(true)
  paradas        ParadaProducao[]
  paradasMaquina ParadaMaquina[]
}

/// Meta do mês (pré-preenche os boletins e serve de referência nos comparativos).
model MetaProducao {
  id             String @id @default(cuid())
  mes            String @unique // "AAAA-MM"
  metaDiariaM3   Float
  horasDia       Float
  rendimentoMeta Float? // m³ produzido ÷ m³ de toras (0–1)
}

/// Boletim diário da serraria (um turno): preenchido pelo encarregado no fim do dia.
model BoletimProducao {
  id               String           @id @default(cuid())
  data             DateTime         @unique @db.Date
  responsavelId    String
  responsavel      Usuario          @relation(fields: [responsavelId], references: [id])
  metaM3           Float
  horasProgramadas Float
  torasQtd         Int?
  torasM3          Float?
  diametroMedio    Float? // cm
  comprimentoMedio Float? // m
  observacoes      String?
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt
  itens            ItemProducao[]
  paradas          ParadaProducao[]
  /// Cargas de toras serradas neste dia (rastreabilidade)
  cargas           CargaToras[]     @relation("ConsumoToras")
  /// Ciclos de estufa que receberam a madeira deste dia
  ciclos           CicloSecagem[]   @relation("MadeiraCiclo")
  pacotes          Pacote[]
  lotes            Lote[]
}

enum TipoProduto {
  BOM
  APROVEITAMENTO
  REFUGO
}

enum Mercado {
  EXTERNO
  INTERNO
}

/// Produção por bitola (espessura × largura × comprimento em mm).
model ItemProducao {
  id          String          @id @default(cuid())
  boletimId   String
  boletim     BoletimProducao @relation(fields: [boletimId], references: [id], onDelete: Cascade)
  /// Lote (lançamento na grade, com etiqueta) a que a peça pertence
  loteId      String?
  lote        Lote?           @relation(fields: [loteId], references: [id], onDelete: Cascade)
  classe      ClasseMadeira?
  tipo        TipoProduto     @default(BOM)
  mercado     Mercado         @default(EXTERNO)
  espessura   Int
  /// largura usada no m³ (média das marcadas; "Mista" = média de todas)
  largura     Int
  /// larguras marcadas na ficha: "100/85", "Mista"…
  larguras    String?
  comprimento Int
  pecas       Int
  m3          Float
  /// nº da linha da ficha (agrupa os comprimentos de uma mesma linha)
  linha       Int?

  @@index([boletimId])
  @@index([loteId])
}

model ParadaProducao {
  id              String          @id @default(cuid())
  boletimId       String
  boletim         BoletimProducao @relation(fields: [boletimId], references: [id], onDelete: Cascade)
  motivoId        String?
  motivo          MotivoParada?   @relation(fields: [motivoId], references: [id], onDelete: SetNull)
  equipamentoId   String?
  equipamento     Equipamento?    @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  centro          CentroParada
  ocorrencias     Int             @default(1)
  minutos         Float
  descricao       String?
  requisicaoId    Int?
  requisicao      Requisicao?     @relation(fields: [requisicaoId], references: [id], onDelete: SetNull)
  /// Gerada por uma parada marcada na hora (não se edita no formulário do boletim)
  paradaMaquinaId String?
  paradaMaquina   ParadaMaquina?  @relation(fields: [paradaMaquinaId], references: [id], onDelete: Cascade)

  @@unique([paradaMaquinaId, boletimId])
  @@index([boletimId])
  @@index([motivoId])
}

enum OrigemParada {
  SERRARIA // botão "Máquina parou"
  MANUTENCAO // requisição com máquina parada
}

/// Parada de máquina marcada na hora: o cronômetro corre até a liberação; ao fechar, os
/// minutos dentro do turno entram no boletim de cada dia (ParadaProducao).
model ParadaMaquina {
  id             String           @id @default(cuid())
  equipamentoId  String
  equipamento    Equipamento      @relation(fields: [equipamentoId], references: [id])
  motivoId       String?
  motivo         MotivoParada?    @relation(fields: [motivoId], references: [id], onDelete: SetNull)
  centro         CentroParada
  descricao      String?
  inicio         DateTime
  fim            DateTime?
  origem         OrigemParada     @default(SERRARIA)
  abertaPorId    String
  abertaPor      Usuario          @relation("ParadaAberta", fields: [abertaPorId], references: [id])
  encerradaPorId String?
  encerradaPor   Usuario?         @relation("ParadaEncerrada", fields: [encerradaPorId], references: [id])
  /// Requisição de manutenção (MEC/ELE sempre têm uma)
  requisicaoId   Int?             @unique
  requisicao     Requisicao?      @relation(fields: [requisicaoId], references: [id], onDelete: SetNull)
  /// Chave do aparelho (marcada sem internet), para não duplicar no reenvio
  chaveOffline   String?          @unique
  criadoEm       DateTime         @default(now())
  boletins       ParadaProducao[]

  @@index([fim])
  @@index([inicio])
}

// ---------- Estufas ----------

model Estufa {
  id            String                @id @default(cuid())
  numero        Int                   @unique
  nome          String
  capacidadeM3  Float?
  equipamentoId String?               @unique // a mesma estufa no módulo de manutenção
  equipamento   Equipamento?          @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  ativo         Boolean               @default(true)
  ciclos        CicloSecagem[]
  itensEstoque  ItemEstoque[]
  levantamentos LevantamentoEstoque[]
}

enum StatusCiclo {
  EM_SECAGEM
  CONCLUIDO
  CANCELADO
}

model CicloSecagem {
  id             String               @id @default(cuid())
  estufaId       String
  estufa         Estufa               @relation(fields: [estufaId], references: [id])
  numero         Int? // nº do ciclo (controle da estufa)
  status         StatusCiclo          @default(EM_SECAGEM)
  entrada        DateTime
  /// quando o aviso de previsão vencida foi enviado
  alertaAtrasoEm DateTime?
  previsaoSaida  DateTime?
  saida          DateTime?
  umidadeInicial Float?
  umidadeFinal   Float?
  plantao        String? // (antigo, texto livre)
  plantaoId      String?
  plantaoUsuario Usuario?             @relation("PlantaoCiclo", fields: [plantaoId], references: [id], onDelete: SetNull)
  proximaCarga   String?
  observacoes    String?
  responsavelId  String
  responsavel    Usuario              @relation(fields: [responsavelId], references: [id])
  criadoEm       DateTime             @default(now())
  cargas         CargaCiclo[]
  checklist      ItemChecklistCiclo[]
  /// Dias de serraria cuja madeira entrou neste ciclo (rastreabilidade)
  boletins       BoletimProducao[]    @relation("MadeiraCiclo")
  pacotes        Pacote[]

  @@index([estufaId, entrada])
  @@index([status])
}

/// Madeira dentro da estufa: uma linha por bitola/comprimento.
model CargaCiclo {
  id          String       @id @default(cuid())
  cicloId     String
  ciclo       CicloSecagem @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  espessura   Int // mm
  largura     String // ex.: "100/85" ou "Mista"
  comprimento Float // m
  /// grades úmidas (na ficha, ficam na 1ª célula da linha)
  grades      Int          @default(0)
  pecas       Int?
  m3          Float
  linha       Int?

  @@index([cicloId])
}

model ItemChecklistCiclo {
  id           String       @id @default(cuid())
  cicloId      String
  ciclo        CicloSecagem @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  secao        String?
  texto        String
  ordem        Int
  conforme     Boolean? // null = não conferido
  observacao   String?
  marcadoPorId String?
  marcadoPor   Usuario?     @relation(fields: [marcadoPorId], references: [id])
  marcadoEm    DateTime?

  @@index([cicloId, ordem])
}

// ---------- Recebimento de toras ----------

model CargaToras {
  id               String            @id @default(cuid())
  numero           Int               @unique @default(autoincrement())
  colheitaId       String?
  colheita         Colheita?         @relation(fields: [colheitaId], references: [id], onDelete: SetNull)
  boletins         BoletimProducao[] @relation("ConsumoToras")
  data             DateTime
  florestaId       String?
  floresta         OrigemFlorestal?  @relation(fields: [florestaId], references: [id], onDelete: SetNull)
  fornecedorId     String?
  fornecedor       Fornecedor?       @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  motoristaId      String?
  motoristaCad     Motorista?        @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  classeDiametro   ClasseDiametro?
  pesoT            Float? // toneladas
  chaveOffline     String?           @unique
  origem           String? // nome da floresta/fornecedor no momento (histórico)
  talhao           String? // (antigo)
  motorista        String? // nome no momento da carga
  placa            String? // placa do caminhão no momento da carga
  placaJulieta     String?
  comprimentoMedio Float? // m — usado no volume estimado
  observacoes      String?
  responsavelId    String
  responsavel      Usuario           @relation(fields: [responsavelId], references: [id])
  criadoEm         DateTime          @default(now())
  itens            ItemCargaToras[]

  @@index([data])
}

model ItemCargaToras {
  id         String     @id @default(cuid())
  cargaId    String
  carga      CargaToras @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  diametro   Int // cm
  quantidade Int

  @@index([cargaId])
}

// ---------- Estoque de madeira (levantamentos) ----------

enum TipoEstoque {
  VERDE
  EMPACOTADA
}

model LevantamentoEstoque {
  id            String        @id @default(cuid())
  data          DateTime
  tipo          TipoEstoque? // (antigo)
  local         LocalEstoque?
  estufaId      String?
  estufa        Estufa?       @relation(fields: [estufaId], references: [id], onDelete: SetNull)
  espessura     Int?
  chaveOffline  String?       @unique
  observacoes   String?
  responsavelId String
  responsavel   Usuario       @relation(fields: [responsavelId], references: [id])
  criadoEm      DateTime      @default(now())
  itens         ItemEstoque[]

  @@index([tipo, data])
}

model ItemEstoque {
  id             String              @id @default(cuid())
  levantamentoId String
  levantamento   LevantamentoEstoque @relation(fields: [levantamentoId], references: [id], onDelete: Cascade)
  espessura      Int // mm
  largura        String
  comprimento    Float // m
  grades         Int?
  pacotes        Int?
  pecas          Int?
  m3             Float
  linha          Int?
  /// "Madeira em" da linha (inventários novos; os antigos usam o do levantamento)
  local          LocalEstoque?
  estufaId       String?
  estufa         Estufa?             @relation(fields: [estufaId], references: [id], onDelete: SetNull)

  @@index([levantamentoId])
}

// ---------- Rastreabilidade: da floresta ao pacote ----------

enum TipoOrigem {
  PROPRIA
  ARRENDADA
  TERCEIRO
}

/// Floresta / fazenda de onde vêm as toras.
model OrigemFlorestal {
  id           String       @id @default(cuid())
  nome         String
  tipo         TipoOrigem   @default(TERCEIRO)
  proprietario String? // proprietário ou fornecedor
  municipio    String?
  uf           String?
  especie      String? // ex.: Pinus taeda
  anoPlantio   Int?
  areaHa       Float?
  observacoes  String?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  colheitas    Colheita[]
  cargas       CargaToras[]
}

/// Derrubada (colheita) de um talhão: o começo da história de cada pacote.
model Colheita {
  id               String          @id @default(cuid())
  numero           Int             @unique @default(autoincrement())
  origemId         String
  origem           OrigemFlorestal @relation(fields: [origemId], references: [id])
  talhao           String?
  inicio           DateTime        @db.Date
  fim              DateTime?       @db.Date
  equipe           String?
  idadeAnos        Int?
  volumeEstimadoM3 Float?
  documento        String? // nota, licença ou autorização de corte
  observacoes      String?
  responsavelId    String
  responsavel      Usuario         @relation(fields: [responsavelId], references: [id])
  criadoEm         DateTime        @default(now())
  cargas           CargaToras[]

  @@index([origemId, inicio])
}

enum StatusPacote {
  VERDE // formado na serraria, aguardando estufa ou venda verde
  EM_ESTUFA
  SECO // seco/classificado, em estoque
  EXPEDIDO
  CANCELADO
}

enum TipoEvento {
  CRIADO
  ENTRADA_ESTUFA
  SAIDA_ESTUFA
  MOVIMENTADO
  EXPEDIDO
  OBSERVACAO
  ALTERADO
  CANCELADO
}

/// Pacote de madeira serrada, identificado pela etiqueta com QR Code.
model Pacote {
  id            String           @id @default(cuid())
  /// código aleatório do QR público (/p/<código>): não dá para adivinhar outros pacotes
  codigoPublico String?          @unique
  /// etiquetas impressas antes do código aleatório: o QR com o número continua valendo
  qrLegado      Boolean          @default(false)
  numero        Int              @unique @default(autoincrement())
  status        StatusPacote
  pedidoId      String?
  pedido        Pedido?          @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  boletimId     String? // dia em que a madeira foi serrada
  boletim       BoletimProducao? @relation(fields: [boletimId], references: [id], onDelete: SetNull)
  cicloId       String? // ciclo de estufa em que secou
  ciclo         CicloSecagem?    @relation(fields: [cicloId], references: [id], onDelete: SetNull)
  espessura     Int // mm
  largura       Int // mm
  comprimento   Int // mm
  pecas         Int
  m3            Float
  classe        String?
  mercado       Mercado          @default(EXTERNO)
  umidade       Float? // % na formação/saída da estufa
  localizacao   String?
  cliente       String?
  notaFiscal    String?
  destino       String?
  expedidoEm    DateTime?
  /// Romaneio (documento da carga) em que o pacote saiu
  romaneioId    String?
  romaneio      Romaneio?        @relation(fields: [romaneioId], references: [id], onDelete: SetNull)
  observacoes   String?
  criadoPorId   String
  criadoPor     Usuario          @relation(fields: [criadoPorId], references: [id])
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt
  eventos       EventoPacote[]

  @@index([status])
  @@index([boletimId])
  @@index([cicloId])
  @@index([criadoEm])
  @@index([pedidoId])
  @@index([romaneioId])
  @@index([expedidoEm])
}

/// Linha do tempo do pacote (cada leitura/movimentação registrada).
model EventoPacote {
  id        String     @id @default(cuid())
  pacoteId  String
  pacote    Pacote     @relation(fields: [pacoteId], references: [id], onDelete: Cascade)
  tipo      TipoEvento
  descricao String
  usuarioId String?
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id])
  criadoEm  DateTime   @default(now())

  @@index([pacoteId, criadoEm])
}

// ---------- Escopo v2: cadastros, pedidos e lotes da serraria ----------

enum ClasseDiametro {
  FINA
  MEDIA
  GROSSA
}

enum ClasseMadeira {
  OTIMO
  BOM
  REGULAR
}

enum StatusPedido {
  ABERTO
  CONCLUIDO
}

enum LocalEstoque {
  GRADE
  PACOTE
  ESTUFA
  VERDE
}

model Fornecedor {
  id        String       @id @default(cuid())
  nome      String       @unique
  documento String? // CNPJ/CPF
  telefone  String?
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())
  cargas    CargaToras[]
}

model Motorista {
  id            String       @id @default(cuid())
  nome          String
  placaCaminhao String
  placaJulieta  String?
  telefone      String?
  ativo         Boolean      @default(true)
  criadoEm      DateTime     @default(now())
  cargas        CargaToras[]
  romaneios     Romaneio[]
}

/// Romaneio de expedição: o documento da carga que vai com o motorista.
model Romaneio {
  id           String     @id @default(cuid())
  numero       Int        @unique @default(autoincrement())
  motoristaId  String?
  motoristaCad Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  /// nome e placas no momento da saída (histórico)
  motorista    String?
  placa        String?
  placaJulieta String?
  /// nota fiscal da carga
  notaFiscal   String?
  /// chave de acesso da NF-e (44 dígitos)
  chaveNfe     String?
  observacoes  String?
  criadoPorId  String
  criadoPor    Usuario    @relation("RomaneiosCriados", fields: [criadoPorId], references: [id])
  criadoEm     DateTime   @default(now())
  pacotes      Pacote[]

  @@index([criadoEm])
}

/// Pedido do cliente: a produção da serraria é lançada já ligada a ele.
model Pedido {
  id              String       @id @default(cuid())
  numero          String       @unique
  cliente         String
  /// volume combinado (m³) — base do saldo e do aviso de pedido pronto
  volumeM3        Float?
  /// prazo de entrega
  prazo           DateTime?    @db.Date
  destino         String?
  observacoes     String?
  status          StatusPedido @default(ABERTO)
  criadoEm        DateTime     @default(now())
  /// quando o aviso "pedido pronto para expedir" foi enviado
  prontoAvisadoEm DateTime?
  lotes           Lote[]
  pacotes         Pacote[]
}

/// Lançamento da grade da serraria (uma espessura, um pedido) — vira etiqueta com código de barras e QR.
model Lote {
  id           String          @id @default(cuid())
  numero       Int             @unique @default(autoincrement())
  boletimId    String
  boletim      BoletimProducao @relation(fields: [boletimId], references: [id], onDelete: Cascade)
  pedidoId     String
  pedido       Pedido          @relation(fields: [pedidoId], references: [id])
  /// espessura do lote quando todas as linhas têm a mesma
  espessura    Int?
  criadoPorId  String
  criadoPor    Usuario         @relation(fields: [criadoPorId], references: [id])
  criadoEm     DateTime        @default(now())
  chaveOffline String?         @unique
  itens        ItemProducao[]

  @@index([boletimId])
  @@index([pedidoId])
}

/// Configuração padrão da serraria (meta e horas que vêm preenchidas no boletim).
model ConfigSerraria {
  id             String   @id @default("padrao")
  metaDiariaM3   Float
  horasDia       Float
  rendimentoMeta Float?
  /// Turno ("HH:MM", Brasília): só o tempo parado dentro dele entra no boletim
  turnoInicio    String   @default("07:00")
  turnoFim       String   @default("17:00")
  atualizadoEm   DateTime @updatedAt
}

/// Tentativas de login sem sucesso (limite contra programas que testam senhas).
model TentativaLogin {
  id       String   @id @default(cuid())
  /// "login:nome.sobrenome", "ip:1.2.3.4" ou "senha:<usuarioId>"
  chave    String
  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
}
